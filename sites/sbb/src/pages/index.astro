---
// Trang gốc "/" -> điều hướng sang bản TIẾNG ANH (mặc định của site).
// Bản tiếng Việt ở /vi (xem pages/vi.astro). Static-safe: meta refresh + JS + canonical.
const TARGET = '/en/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${TARGET}`} />
    <link rel="canonical" href={`https://sbb.edu.vn${TARGET}`} />
    <link rel="alternate" hreflang="en" href="https://sbb.edu.vn/en/" />
    <link rel="alternate" hreflang="vi" href="https://sbb.edu.vn/vi" />
    <link rel="alternate" hreflang="x-default" href="https://sbb.edu.vn/en/" />
    <title>Shine Beyond Borders</title>
    <script is:inline>location.replace('/en/');</script>
  </head>
  <body style="margin:0;background:#120502;color:#fff;font-family:system-ui,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center;">
    <p style="font-size:1rem;">Redirecting to <a href="/en/" style="color:#ff5c26;">Shine Beyond Borders</a>…</p>
  </body>
</html>
