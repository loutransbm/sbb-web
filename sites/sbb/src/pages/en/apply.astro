---
import PageLayout from '@ui/layouts/PageLayout.astro';

const steps = [
  {
    num: '01',
    title: 'Leave your details',
    body: 'Sign up through the form or message us directly. Just a few lines about who you are and what interests you, with nothing complicated to prepare.',
  },
  {
    num: '02',
    title: 'Free capability assessment',
    body: 'SBB sits down with you for a session to look honestly at your profile, your strengths and your goals. Straightforward, no fluff, even when the answer is "not yet, don\'t rush."',
  },
  {
    num: '03',
    title: 'Get a personalised roadmap',
    body: 'Based on your real situation, SBB maps out the right path for you: what to prepare, which direction to take, with transparent costs from the start. No empty promises.',
  },
  {
    num: '04',
    title: 'Start the journey together',
    body: 'When you are ready, SBB walks with you every step of the way, until you truly stand firm in an international environment, without letting go halfway.',
  },
];

const channels = [
  'Hotline & Zalo: 09xx xxx xxx. The fastest way to reach us, with replies during working hours.',
  'Email: hello@sbb.vn. Send your profile or a longer question, and SBB replies within 1–2 days.',
  'Office: drop by in person for a deeper conversation (please book ahead so SBB can set aside time).',
];

const inputStyle =
  'width:100%;font-family:var(--font-body);font-size:1rem;padding:0.85rem 1.1rem;border:1px solid rgba(0,0,0,0.12);border-radius:14px;background:#FFFFFF;color:var(--ink);';
const labelStyle =
  'display:block;font-family:var(--font-headline);font-weight:600;font-size:0.8rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:0.55rem;';
---

<PageLayout
  title="Contact"
  description="Book a consultation with SBB: leave your details, get a free capability assessment and receive a personalised roadmap."
  site="sbb"
  currentPath="/apply"
>
  <!-- ===== HERO ===== -->
  <section class="o-hero">
    <div class="container">
      <span class="o-eyebrow">Contact</span>
      <h1 class="o-mega">BOOK A <span class="o-accent">CONSULTATION</span></h1>
      <p class="o-lead">Whenever you feel ready, SBB sits down with you for a session. No hard sell, no pressure. Just one honest conversation to see together which path truly fits you.</p>
    </div>
  </section>

  <!-- ===== WHAT HAPPENS NEXT ===== -->
  <section class="o-section">
    <div class="container">
      <div class="o-head">
        <span class="o-head-eyebrow">Process</span>
        <h2 class="o-head-title">WHAT HAPPENS <span class="o-stroke">NEXT</span></h2>
        <p class="o-head-desc">After you reach out, here are the four steps SBB takes with you, transparent from start to finish, with no strings and no pressure.</p>
      </div>
      <div class="o-rows">
        {steps.map((s) => (
          <article class="o-row">
            <span class="o-row__num">{s.num}</span>
            <div>
              <h3 class="o-row__title">{s.title}</h3>
              <p class="o-row__body">{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CHANNELS + REASSURANCE ===== -->
  <section class="o-section o-section--tint o-section--glow">
    <div class="container">
      <div class="o-split o-split--top">
        <div>
          <span class="o-head-eyebrow">Reach Us</span>
          <h2 class="o-head-title">TALK TO <span class="o-stroke">SBB</span></h2>
          <ul class="o-checks o-mt-lg">
            {channels.map((c) => (<li>{c}</li>))}
          </ul>
          <div class="o-actions o-mt-lg">
            <a href="#contact-form" class="o-btn o-btn--primary">Message SBB</a>
            <a href="/programs" class="o-btn o-btn--ghost">View programs</a>
          </div>
        </div>
        <div>
          <p class="o-statement">You don't need to be perfectly ready. You just need to be <span class="o-accent">ready to start</span> a conversation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FORM ===== -->
  <section class="o-section" id="contact-form">
    <div class="container">
      <div class="o-head">
        <span class="o-head-eyebrow">Leave your details</span>
        <h2 class="o-head-title">SEND A <span class="o-stroke">MESSAGE</span></h2>
        <p class="o-head-desc">Fill in a few lines so SBB can understand you better before the conversation. Your information stays confidential, and SBB will get back to you as soon as possible.</p>
      </div>

      <div class="o-card" style="max-width:46rem;">
        <form action="#" method="POST" style="display:flex;flex-direction:column;gap:1.4rem;">
          <div>
            <label for="name" style={labelStyle}>Full name <span style="color:var(--accent);">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" style={inputStyle} />
          </div>

          <div>
            <label for="contact" style={labelStyle}>Email or phone number <span style="color:var(--accent);">*</span></label>
            <input type="text" id="contact" name="contact" required placeholder="So SBB can get back to you" style={inputStyle} />
          </div>

          <div>
            <span style={labelStyle}>You are a</span>
            <div style="display:flex;flex-wrap:wrap;gap:1.4rem;">
              <label style="display:flex;align-items:center;gap:0.5rem;color:var(--ink-soft);"><input type="radio" name="role" value="sinh-vien" checked style="accent-color:var(--accent);width:1.1em;height:1.1em;" /> <span>Student</span></label>
              <label style="display:flex;align-items:center;gap:0.5rem;color:var(--ink-soft);"><input type="radio" name="role" value="phu-huynh" style="accent-color:var(--accent);width:1.1em;height:1.1em;" /> <span>Parent</span></label>
              <label style="display:flex;align-items:center;gap:0.5rem;color:var(--ink-soft);"><input type="radio" name="role" value="khac" style="accent-color:var(--accent);width:1.1em;height:1.1em;" /> <span>Other</span></label>
            </div>
          </div>

          <div>
            <label for="interest" style={labelStyle}>Field / Interest</label>
            <input type="text" id="interest" name="interest" placeholder="For example: Hospitality, IT, J-1..." style={inputStyle} />
          </div>

          <div>
            <label for="message" style={labelStyle}>Message</label>
            <textarea id="message" name="message" rows="4" placeholder="What else would you like SBB to know?" style={inputStyle + 'resize:vertical;min-height:7rem;'}></textarea>
          </div>

          <div class="o-actions" style="margin-top:0.4rem;">
            <button type="submit" class="o-btn o-btn--primary">Submit</button>
          </div>
          <p style="font-size:0.85rem;color:var(--ink-muted);line-height:1.6;margin:0;">Your information stays confidential. SBB does not share personal data with third parties.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="o-cta">
    <div class="container">
      <h2 class="o-cta__title">READY TO TALK?</h2>
      <p class="o-cta__sub">An honest conversation costs you nothing, but it can help you see the road ahead clearly.</p>
      <div class="o-actions">
        <a href="#contact-form" class="o-btn o-btn--primary">Message SBB</a>
        <a href="/programs" class="o-btn o-btn--ghost">View programs</a>
      </div>
    </div>
  </section>
</PageLayout>
