  .pl-modal__close { position: absolute; top: 1.1rem; right: 1.1rem; display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.7); cursor: pointer; transition: border-color .25s ease, color .25s ease; }
  .pl-modal__close:hover { border-color: rgba(242,66,11,0.5); color: #fff; }
  .pl-modal__eyebrow { display: inline-block; font-family: var(--font-headline); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: #f2420b; margin-bottom: 0.6rem; }
  .pl-modal__title { font-family: 'Inter', sans-serif; font-weight: 500; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; color: #fff; margin: 0 0 0.4rem; }
  .pl-modal__job { font-family: 'Inter', sans-serif; font-weight: 300; font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0 0 1.6rem; }
  .pl-modal__job b { color: #f2420b; font-weight: 500; }
  .pl-apply-form { display: flex; flex-direction: column; gap: 1rem; }
  .pl-af-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pl-af-field { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .pl-af-field > span { font-family: 'Inter', sans-serif; font-weight: 400; font-size: 0.76rem; letter-spacing: 0.02em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
