---
import PageLayout from '@ui/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

// ===== ĐƠN APPLY GỬI VỀ ĐÂU =====
// Chưa gắn Google Form -> tạm dùng mailto: nút Apply mở email của học sinh, soạn sẵn gửi về hòm thư SBB.
// KHI CÓ Google Form: điền APPLY_FORM_URL = link "viewform" -> nút Gửi sẽ mở Form đó (mở tab mới).
const APPLY_EMAIL = 'loutran.edugate@gmail.com';
const APPLY_FORM_URL = ''; // vd: 'https://docs.google.com/forms/d/e/XXXX/viewform'

const TYPE_LABELS = {
  'j1-intern': 'J-1 Intern', 'j1-trainee': 'J-1 Trainee', '407': 'Visa 407', 'other': 'Other',
};
const fmtDate = (dt) => dt.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });

const entries = await getCollection('jobs');
const jobs = entries
  .map((e) => ({ slug: e.id, ...e.data, typeLabel: TYPE_LABELS[e.data.type] || e.data.type }))
  .sort((a, b) => (Number(!!b.featured) - Number(!!a.featured)) || (b.published.getTime() - a.published.getTime()));

// Bộ lọc suy ra từ dữ liệu
const typeOrder = ['j1-intern', 'j1-trainee', '407', 'other'];
const types = typeOrder.filter((t) => jobs.some((j) => j.type === t));
const fields = Array.from(new Set(jobs.map((j) => j.field))).sort();
const countries = Array.from(new Set(jobs.map((j) => j.country)));
const openCount = jobs.length;
---

<PageLayout
  title="Placements"
  description="SBB's J-1 and 407 jobs board: internship and training positions at hotels and restaurants across the US and Australia. See the details and apply right on the page."
  site="sbb"
  currentPath="/placements"
>
  <!-- ===== HERO ===== -->
  <section class="pl-hero">
    <div class="pl-hero__glow" aria-hidden="true"></div>
    <div class="container pl-hero__inner">
      <span class="pl-hero__eyebrow">SBB Placements</span>
      <h1 class="pl-hero__title"><span class="cs-text-white">FIND YOUR</span> <span class="pl-hero__accent">PLACEMENT</span></h1>
      <p class="pl-hero__lead">SBB's J-1 and 407 jobs board. Internship and training positions at hotels and restaurants across the US and Australia. See the details and apply right on the page.</p>
      <div class="pl-hero__stats">
        <span class="pl-stat"><b>{openCount}</b> open positions</span>
        <span class="pl-stat"><b>{countries.length}</b> countries</span>
        <span class="pl-stat"><b>{fields.length}</b> industries</span>
      </div>
    </div>
  </section>

  <!-- ===== JOBS BOARD ===== -->
  <section class="o-section pl-board">
    <div class="container">
      <!-- Toolbar: lọc loại visa + tìm kiếm -->
      <div class="pl-toolbar">
        <div class="pl-filters" role="group" aria-label="Filter by program">
          <button type="button" class="pl-filter is-active" data-filter-type="all">All</button>
          {types.map((t) => (
            <button type="button" class="pl-filter" data-filter-type={t}>{TYPE_LABELS[t]}</button>
          ))}
        </div>
        <label class="pl-search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.2-4.2"/></svg>
          <input type="search" id="plSearch" placeholder="Search position, company, location..." autocomplete="off" aria-label="Search jobs" />
        </label>
      </div>
      <!-- Lọc phụ theo ngành -->
      <div class="pl-fields" role="group" aria-label="Filter by industry">
        <button type="button" class="pl-fieldchip is-active" data-filter-field="all">All industries</button>
        {fields.map((f) => (
          <button type="button" class="pl-fieldchip" data-filter-field={f}>{f}</button>
        ))}
      </div>

      <!-- Lưới job -->
      <div class="pl-grid">
        {jobs.map((j) => (
          <article class="pl-card" data-type={j.type} data-field={j.field} data-text={`${j.title} ${j.company} ${j.location} ${j.field}`.toLowerCase()}>
            {j.featured && <span class="pl-card__flag">Featured</span>}
            <div class="pl-card__top">
              {j.logo
                ? <span class="pl-card__logo pl-card__logo--img"><img src={j.logo} alt={j.company} loading="lazy" onerror="this.closest('.pl-card__logo').classList.remove('pl-card__logo--img');this.remove()" /></span>
                : <span class="pl-card__logo">{j.company.trim().slice(0, 1)}</span>}
              <div class="pl-card__co">
                <span class="pl-card__company">{j.company}</span>
                <span class="pl-card__loc">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                  {j.location}
                </span>
              </div>
            </div>
            <h3 class="pl-card__title">{j.title}</h3>
            <div class="pl-card__badges">
              <span class="pl-badge pl-badge--type">{j.typeLabel}</span>
              <span class="pl-badge">{j.field}</span>
            </div>
            {j.summary && <p class="pl-card__summary">{j.summary}</p>}
            <div class="pl-card__facts">
              {j.pay && (<span class="pl-fact"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M9.5 10a2.5 2 0 0 1 5 0c0 2.5-5 1.5-5 4a2.5 2 0 0 0 5 0"/></svg>{j.pay}</span>)}
              {j.duration && (<span class="pl-fact"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>{j.duration}</span>)}
              {j.positions && (<span class="pl-fact"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="9" r="3"/><path d="M3 20a6 6 0 0 1 12 0M16 7a3 3 0 0 1 0 6M21 20a6 6 0 0 0-4-5.6"/></svg>{j.positions} openings</span>)}
            </div>
            <div class="pl-card__foot">
              <span class="pl-card__deadline">{j.deadline ? `Deadline: ${fmtDate(j.deadline)}` : 'Rolling admission'}</span>
              <button type="button" class="pl-apply-btn" data-apply data-job={j.title} data-company={j.company}>
                Apply
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </article>
        ))}
      </div>
      <p class="pl-empty" hidden>No positions match your filters. Try removing a few.</p>
    </div>
  </section>

  <!-- ===== APPLY MODAL ===== -->
  <div class="pl-modal" id="applyModal" hidden>
    <div class="pl-modal__overlay" data-close aria-hidden="true"></div>
    <div class="pl-modal__panel" role="dialog" aria-modal="true" aria-labelledby="applyTitle">
      <button type="button" class="pl-modal__close" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <span class="pl-modal__eyebrow">Submit your application</span>
      <h2 class="pl-modal__title" id="applyTitle">Apply</h2>
      <p class="pl-modal__job" id="applyJobLine"></p>
      <form class="pl-apply-form" id="applyForm" novalidate>
        <input type="hidden" name="job" id="applyJobInput" />
        <div class="pl-af-row">
          <label class="pl-af-field"><span>Full name <i>*</i></span><input name="name" type="text" required autocomplete="name" placeholder="Jane Doe" /></label>
          <label class="pl-af-field"><span>Email <i>*</i></span><input name="email" type="email" required autocomplete="email" placeholder="you@email.com" /></label>
        </div>
        <div class="pl-af-row">
          <label class="pl-af-field"><span>Phone number <i>*</i></span><input name="phone" type="tel" required autocomplete="tel" placeholder="+84 9xx xxx xxx" /></label>
          <label class="pl-af-field"><span>CV link (Drive / PDF)</span><input name="cv" type="url" placeholder="https://..." /></label>
        </div>
        <label class="pl-af-field"><span>Message</span><textarea name="note" rows="3" placeholder="A few lines about yourself and why you're a fit for this role..."></textarea></label>
        <button type="submit" class="pl-af-submit">
          Send application
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7 17 17"/><path d="M17 7v10H7"/></svg>
        </button>
        <p class="pl-af-hint">Your application goes straight to the SBB recruiting team.</p>
      </form>
    </div>
  </div>

  <!-- ============ FINAL CTA · "READY TO SHINE BEYOND BORDERS" (giống Omni "READY TO GROW & SCALE") ============ -->
  <section class="cta-final" id="get-started">
    <div class="container cta-final-inner">
      <!-- Cascade trái: READY / TO SHINE (+pill) / BEYOND BORDERS? — bê y hệt homepage -->
      <div class="cs-header cta-header">
        <div class="cs-line cs-line-1">
          <span class="cs-text-white">READY</span>
        </div>
        <div class="cta-line-2">
          <span class="cta-verb">TO SHINE</span>
          <div class="cs-glass-pill">
            <span class="cs-glass-title">LET'S TALK</span>
            <span class="cs-glass-sub">A free 30-minute consultation to map out a clear path with SBB.</span>
          </div>
        </div>
        <div class="cta-line-3">
          <span class="cta-tail"><span class="cs-text-white">BEYOND BORDERS?</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LEAD FORM · (giống Omni contact form: 2 cột, label in hoa, input gạch chân, dropdown, nút pill) ============ -->
  <section class="lead-form" id="lead-form">
    <div class="container">
      <form class="lf-grid" action="#" method="POST" novalidate>
        <!-- Hàng 1: Họ tên | Số điện thoại -->
        <div class="lf-field">
          <label class="lf-label" for="lf-name">YOUR FULL NAME<span class="lf-req">*</span></label>
          <input class="lf-input" id="lf-name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" />
        </div>
        <div class="lf-field">
          <label class="lf-label" for="lf-phone">PHONE NUMBER<span class="lf-req">*</span></label>
          <input class="lf-input" id="lf-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+84 9xx xxx xxx" />
        </div>

        <!-- Hàng 2: Email | Bạn đang là -->
        <div class="lf-field">
          <label class="lf-label" for="lf-email">YOUR EMAIL<span class="lf-req">*</span></label>
          <input class="lf-input" id="lf-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
        </div>
        <div class="lf-field">
          <label class="lf-label" for="lf-role">WHO ARE YOU?</label>
          <div class="lf-select-wrap">
            <select class="lf-input lf-select" id="lf-role" name="role">
              <option value="" disabled selected>Select a role</option>
              <option>Student</option>
              <option>Working professional</option>
              <option>Parent</option>
              <option>Other</option>
            </select>
          </div>
        </div>

        <!-- Hàng 3: Chương trình quan tâm | Mục tiêu -->
        <div class="lf-field">
          <label class="lf-label" for="lf-program">WHICH PROGRAM INTERESTS YOU?</label>
          <div class="lf-select-wrap">
            <select class="lf-input lf-select" id="lf-program" name="program">
              <option value="" disabled selected>Select a program</option>
              <option>GRP — Global Readiness</option>
              <option>Internship J-1</option>
              <option>Office Tour</option>
              <option>407 Training</option>
              <option>Not sure — need advice</option>
            </select>
          </div>
        </div>
        <div class="lf-field">
          <label class="lf-label" for="lf-goal">WHAT IS YOUR GOAL?</label>
          <div class="lf-select-wrap">
            <select class="lf-input lf-select" id="lf-goal" name="goal">
              <option value="" disabled selected>Select a goal</option>
              <option>Study abroad</option>
              <option>International internship</option>
              <option>Work abroad</option>
              <option>Long-term settlement</option>
            </select>
          </div>
        </div>

        <!-- Hàng 4: Mốc thời gian | Nút gửi -->
        <div class="lf-field">
          <label class="lf-label" for="lf-timeline">WHEN DO YOU PLAN TO GO?</label>
          <div class="lf-select-wrap">
            <select class="lf-input lf-select" id="lf-timeline" name="timeline">
              <option value="" disabled selected>Select a timeline</option>
              <option>Within the next 6 months</option>
              <option>6 – 12 months</option>
              <option>More than a year</option>
              <option>Not decided yet</option>
            </select>
          </div>
        </div>
        <div class="lf-field lf-field--submit">
          <button class="lf-submit" type="submit">
            <span class="lf-submit-label">SEND INFO</span>
            <span class="lf-submit-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><path d="M7 7 17 17"/><path d="M17 7v10H7"/></svg>
            </span>
          </button>
        </div>
      </form>
    </div>
  </section>
</PageLayout>

<style>
  /* ===== Cascade heading (bê từ news) ===== */
  .cs-header { margin-bottom: 0; font-weight: 500; line-height: 0.95; letter-spacing: -0.045em; font-family: 'Inter', sans-serif; }
    .cs-line { display: flex; align-items: center; gap: 1.5rem; }
    .cs-line-1 { font-size: clamp(8.5rem, 12vw, 11rem); letter-spacing: -0.085em; white-space: nowrap; position: relative; z-index: 10; }
  .about-line-2 { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 0.5rem; }
    .about-verb { font-size: clamp(8.5rem, 12vw, 11rem); letter-spacing: -0.085em; line-height: 0.9; white-space: nowrap; margin-left: clamp(2.5rem, 7.5vw, 7.5rem); }
  .about-tail { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; font-size: clamp(3rem, 5vw, 6.5rem); letter-spacing: -0.07em; line-height: 0.92; text-align: right; }
    .about-tail span { display: block; white-space: nowrap; }

  .cs-text-white { color: #ffffff !important; }
  /* PILL KÍNH = Y HỆT about/programs (dark) */
  .cs-glass-pill {
    display: inline-flex; flex-direction: column; flex-shrink: 0;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: var(--space-4) var(--space-5);
    width: 240px; min-height: 7.25rem;
    justify-content: center; text-align: left;
    box-shadow:
      0 30px 44px -10px rgba(0, 0, 0, 0.78),
      0 14px 24px -8px rgba(0, 0, 0, 0.55),
      0 0 40px rgba(242, 66, 11, 0.12),
      inset 0 1px 1px rgba(255, 255, 255, 0.12);
  }
  .cs-glass-title {
    font-family: var(--font-headline);
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
    font-weight: 600; color: #ffffff; line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap; text-transform: uppercase;
  }
  .cs-glass-sub {
    font-family: 'Inter', sans-serif; font-weight: 400; font-size: 11px;
    line-height: 1.45; color: rgba(255, 255, 255, 0.62); white-space: normal;
    max-width: 25ch; margin: 0;
    letter-spacing: normal;
  }

  /* ============================================================
     PLACEMENTS — hero + jobs board + card + apply modal (dark fire)
     ============================================================ */
  .pl-hero { position: relative; padding: clamp(9rem, 12vw, 13rem) 0 clamp(3rem, 5vw, 5rem); overflow: hidden; }
  .pl-hero__glow { position: absolute; top: 28%; left: 74%; transform: translateX(-50%); width: 1100px; height: 760px; pointer-events: none; z-index: 0; filter: blur(80px);
    background: radial-gradient(ellipse 50% 50% at 50% 42%, rgba(255,112,60,0.5) 0%, rgba(248,82,26,0.3) 26%, rgba(242,66,11,0.13) 52%, transparent 80%); }
  .pl-hero__inner, .pl-board .container { position: relative; z-index: 1; max-width: none; width: 100%; padding-inline: clamp(1.5rem, 3.2vw, 3.25rem); }
  .pl-hero__eyebrow { display: inline-block; font-family: var(--font-headline); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.28em; text-transform: uppercase; color: #f2420b; margin-bottom: 1.2rem; }
  .pl-hero__title { font-family: 'Inter', sans-serif; font-weight: 500; font-size: clamp(3rem, 9vw, 8rem); line-height: 0.95; letter-spacing: -0.05em; margin: 0 0 1.6rem; }
  .pl-hero__title .cs-text-white { color: #fff; }
  .pl-hero__accent { color: #f2420b; }
  .pl-hero__lead { font-family: 'Inter', sans-serif; font-weight: 300; font-size: clamp(1rem, 1.35vw, 1.25rem); line-height: 1.65; color: rgba(255,255,255,0.66); max-width: 58ch; margin: 0 0 2.2rem; }
  .pl-hero__stats { display: flex; flex-wrap: wrap; gap: clamp(1.6rem, 3.5vw, 3.2rem); }
  .pl-stat { font-family: 'Inter', sans-serif; font-weight: 300; font-size: 0.95rem; color: rgba(255,255,255,0.6); }
  .pl-stat b { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1.7rem; color: #fff; margin-right: 0.45rem; letter-spacing: -0.02em; }

  .pl-board { padding-top: clamp(1rem, 2vw, 2rem); }
  /* Toolbar: lọc chương trình + tìm kiếm */
  .pl-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 1.5rem; margin-bottom: 1.2rem; }
  .pl-filters { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pl-filter { font-family: 'Inter', sans-serif; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.02em; color: rgba(255,255,255,0.78); cursor: pointer; padding: 0.6rem 1.2rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.05); transition: background .25s ease, border-color .25s ease, color .25s ease; }
  .pl-filter:hover { border-color: rgba(242,66,11,0.5); background: rgba(242,66,11,0.10); color: #fff; }
  .pl-filter.is-active { border-color: transparent; color: #fff; background: linear-gradient(180deg, #ff5c26 0%, #f2420b 100%); box-shadow: 0 12px 30px -10px rgba(242,66,11,0.45), inset 0 1px 1px rgba(255,255,255,0.25); }
  .pl-search { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1.1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.55); min-width: min(300px, 100%); transition: border-color .25s ease, color .25s ease; }
  .pl-search:focus-within { border-color: rgba(242,66,11,0.55); color: #fff; }
  .pl-search input { border: 0; background: transparent; outline: none; color: #fff; width: 100%; font-family: 'Inter', sans-serif; font-size: 0.92rem; }
  .pl-search input::placeholder { color: rgba(255,255,255,0.45); }
  /* Lọc phụ theo ngành */
  .pl-fields { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: clamp(2rem, 3.5vw, 3rem); padding-bottom: clamp(1.6rem, 2.5vw, 2.4rem); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .pl-fieldchip { font-family: 'Inter', sans-serif; font-size: 0.8rem; font-weight: 500; color: rgba(255,255,255,0.6); cursor: pointer; padding: 0.42rem 0.9rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.10); background: transparent; transition: border-color .25s ease, color .25s ease, background .25s ease; }
  .pl-fieldchip:hover { color: #fff; border-color: rgba(242,66,11,0.4); }
  .pl-fieldchip.is-active { color: #f2420b; border-color: rgba(242,66,11,0.5); background: rgba(242,66,11,0.08); }

  /* Lưới job */
  .pl-grid { display: grid; gap: clamp(1.3rem, 2vw, 2rem); grid-template-columns: repeat(3, 1fr); }
  .pl-card { position: relative; display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.10); border-radius: 24px; background: transparent; padding: clamp(1.6rem, 2.2vw, 2.1rem); box-shadow: 0 8px 24px rgba(0,0,0,0.4); transition: border-color .4s ease, transform .4s ease, box-shadow .4s ease; }
  .pl-card:hover { border-color: rgba(242,66,11,0.55); transform: translateY(-4px); box-shadow: 0 26px 60px -24px rgba(0,0,0,0.5); }
  .pl-card__flag { position: absolute; top: 1.2rem; right: 1.2rem; font-family: var(--font-headline); font-weight: 600; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: #f2420b; background: rgba(242,66,11,0.12); border: 1px solid rgba(242,66,11,0.4); border-radius: 999px; padding: 0.24rem 0.6rem; }
  .pl-card__top { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.1rem; }
  .pl-card__logo { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1.2rem; color: #fff; background: linear-gradient(150deg, #f2420b, #7a1f05); overflow: hidden; }
  .pl-card__logo--img { background: #1a0d08; }
  .pl-card__logo img { width: 100%; height: 100%; object-fit: cover; }
  .pl-card__co { min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .pl-card__company { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 0.95rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-card__loc { display: inline-flex; align-items: center; gap: 0.35rem; font-family: 'Inter', sans-serif; font-weight: 300; font-size: 0.8rem; color: rgba(255,255,255,0.5); }
